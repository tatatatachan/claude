function createAll() {
  const folder = DriveApp.getFolderById(FOLDER_ID);
  const reg = createRegistrationForm_();
  const rep = createReportForm_();
  [reg.form, reg.ss, rep.form, rep.ss].forEach(f => DriveApp.getFileById(f.getId()).moveTo(folder));
  Logger.log('登録フォーム（団体に送る）: ' + reg.form.getPublishedUrl());
  Logger.log('お繋ぎ報告フォームの回答シート: ' + rep.ss.getUrl());
  Logger.log('アライアンス別の報告リンクは、回答シートの「アライアンス別 報告リンク」タブにあります。');
}

function createRegistrationForm_() {
  const form = FormApp.create('visions アライアンス登録フォーム');
  form.setDescription('visionsとアライアンス・連携をしてくださる団体・企業・個人の登録フォームです。\nいただいた情報は、visions運営チームがアライアンスの管理とご連絡のためにのみ使用します。\n所要時間：約3分')
      .setCollectEmail(true)
      .setConfirmationMessage('ご登録ありがとうございます！visionsの担当者から、数日以内にご連絡します。');
  form.addMultipleChoiceItem().setTitle('登録するのは').setChoiceValues(['団体・企業', '個人']).setRequired(true);
  form.addTextItem().setTitle('団体名・企業名（個人の方は空欄）');
  form.addTextItem().setTitle('お名前（代表者・ご担当者）').setRequired(true);
  form.addTextItem().setTitle('大学名・所属');
  form.addCheckboxItem().setTitle('主な活動地域（都道府県・複数可）').setChoiceValues(PREFECTURES).setRequired(true);
  form.addParagraphTextItem().setTitle('活動内容を教えてください').setRequired(true);
  form.addTextItem().setTitle('Webサイト・SNSのURL').setValidation(FormApp.createTextValidation().requireTextIsUrl().build());
  form.addSectionHeaderItem().setTitle('ソーシャルテーマとキャリア観')
      .setHelpText('visionsでは、社会の課題や未来を「15のソーシャルテーマ」、はたらき方の価値観を「18のキャリア観」として整理しています。');
  form.addCheckboxItem().setTitle('活動に近いソーシャルテーマ（2つまで）').setChoiceValues(SOCIAL_THEMES)
      .setValidation(FormApp.createCheckboxValidation().requireSelectAtMost(2).build()).setRequired(true);
  form.addCheckboxItem().setTitle('メンバーに多いキャリア観（2つまで）').setChoiceValues(CAREER_VIEWS)
      .setValidation(FormApp.createCheckboxValidation().requireSelectAtMost(2).build()).setRequired(true);
  form.addCheckboxItem().setTitle('visionsと一緒にやりたいこと').setChoiceValues([
      'メンバー・知り合いの学生をvisionsに紹介したい（アライアンス契約）', 'イベントを共催したい',
      'キャリアの授業・講座を開きたい', '団体のブランディングを相談したい', 'まずは話を聞いてみたい']).showOtherOption(true).setRequired(true);
  form.addTextItem().setTitle('visionsの担当者名（分かれば）');
  form.addParagraphTextItem().setTitle('その他、伝えたいこと・質問');
  form.addMultipleChoiceItem().setTitle('個人情報の取り扱いについて')
      .setHelpText('ご入力いただいた情報は、visions運営チームがアライアンスの管理とご連絡のためにのみ使用します。')
      .setChoiceValues(['同意する']).setRequired(true);
  const ss = SpreadsheetApp.create('visions アライアンス登録フォーム（回答）');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  return { form, ss };
}

function createReportForm_() {
  const form = FormApp.create('visions お繋ぎ報告フォーム');
  form.setDescription('visionsに学生をつないでいただいたときの報告フォームです。\n1人につき1回送ってください。合言葉はお送りしたリンクに入っています。')
      .setConfirmationMessage('ご報告ありがとうございます！visionsのキャリアコーチから学生さんにご連絡します。')
      .setLimitOneResponsePerUser(false);
  const codeItem = form.addTextItem().setTitle('合言葉（変更しないでください）').setRequired(true);
  form.addTextItem().setTitle('学生のお名前').setRequired(true);
  form.addTextItem().setTitle('大学・学部').setRequired(true);
  form.addMultipleChoiceItem().setTitle('卒業年度').setChoiceValues(['27卒', '28卒', '29卒', '30卒']).showOtherOption(true).setRequired(true);
  form.addTextItem().setTitle('学生の連絡先（メールアドレス・LINE名など）');
  form.addMultipleChoiceItem().setTitle('つなぎ方').setChoiceValues(['キャリア面談', 'イベント参加', 'まだ決まっていない']).setRequired(true);
  form.addTextItem().setTitle('面談・イベントの希望日（分かれば）');
  form.addParagraphTextItem().setTitle('学生さんについて（どんな人か・悩んでいることなど）');
  const ss = SpreadsheetApp.create('visions お繋ぎ報告フォーム（回答）');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  // アライアンス別の専用リンク
  const sheet = ss.insertSheet('アライアンス別 報告リンク');
  sheet.appendRow(['一覧ページのID', 'アライアンス先', '種類', '合言葉', '専用の報告リンク（この相手にだけ送る）']);
  PARTNERS.forEach(([id, name, code, kind]) => {
    const url = form.createResponse().withItemResponse(codeItem.asTextItem().createResponse(code)).toPrefilledUrl();
    sheet.appendRow([id, name, kind, code, url]);
  });
  sheet.autoResizeColumns(1, 4);
  return { form, ss };
}

/** あとから合言葉を追加したいとき：PARTNERS に [ID, 名前, 合言葉, 種類] を足して、この関数を実行 */
function addPartnerLinks() {
  const files = DriveApp.getFilesByName('visions お繋ぎ報告フォーム');
  if (!files.hasNext()) throw new Error('お繋ぎ報告フォームが見つかりません');
  const form = FormApp.openById(files.next().getId());
  const codeItem = form.getItems().find(i => i.getTitle().startsWith('合言葉')).asTextItem();
  const ss = SpreadsheetApp.openById(form.getDestinationId());
  const sheet = ss.getSheetByName('アライアンス別 報告リンク');
  const have = new Set(sheet.getRange(2, 4, Math.max(1, sheet.getLastRow() - 1), 1).getValues().flat());
  PARTNERS.filter(p => !have.has(p[2])).forEach(([id, name, code, kind]) => {
    sheet.appendRow([id, name, kind, code, form.createResponse().withItemResponse(codeItem.createResponse(code)).toPrefilledUrl()]);
  });
}
