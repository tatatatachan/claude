<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.folder-manager</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>/usr/bin/python3 "$HOME/folder-manager/folder_manager.py" --apply organize; if [ "$(date +%u)" = "1" ]; then /usr/bin/python3 "$HOME/folder-manager/folder_manager.py" --apply archive; fi</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/folder-manager.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/folder-manager.err.log</string>
</dict>
</plist>
